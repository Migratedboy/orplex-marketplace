{
  "schemaVersion": 1,
  "id": "brave-search",
  "name": "Brave Search",
  "description": "Web and local search via the Brave Search API.",
  "category": "search",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "token",
  "popular": true,
  "stdio": {
    "command": "npx",
    "args": [
      "-y",
      "@brave/brave-search-mcp-server",
      "--transport",
      "stdio"
    ],
    "env": [
      {
        "name": "BRAVE_API_KEY",
        "label": "API key",
        "secret": true,
        "required": true
      }
    ]
  }
}
