{
  "schemaVersion": 1,
  "id": "aws",
  "name": "AWS",
  "description": "Query and operate AWS resources (S3, EC2, Lambda, CloudWatch…) with your credentials.",
  "category": "cloud",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "token",
  "stdio": {
    "command": "uvx",
    "args": [
      "awslabs.aws-api-mcp-server"
    ],
    "env": [
      {
        "name": "AWS_ACCESS_KEY_ID",
        "label": "Access key id",
        "secret": true,
        "required": true
      },
      {
        "name": "AWS_SECRET_ACCESS_KEY",
        "label": "Secret access key",
        "secret": true,
        "required": true,
        "help": "••••"
      },
      {
        "name": "AWS_REGION",
        "label": "Region",
        "secret": true,
        "required": true,
        "help": "us-east-1"
      }
    ]
  }
}
