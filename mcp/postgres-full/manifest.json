{
  "schemaVersion": 1,
  "id": "postgres-full",
  "name": "PostgreSQL (full access)",
  "description": "Read AND write Postgres: SQL execution, schema health, index tuning.",
  "category": "database",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "token",
  "stdio": {
    "command": "uvx",
    "args": [
      "postgres-mcp"
    ],
    "env": [
      {
        "name": "DATABASE_URI",
        "label": "postgresql://user:pass@host:5432/db",
        "secret": true,
        "required": true
      }
    ]
  }
}
