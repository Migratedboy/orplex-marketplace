{
  "schemaVersion": 1,
  "id": "whatsapp",
  "name": "WhatsApp",
  "description": "Send WhatsApp messages via the Business Cloud API.",
  "category": "comms",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "token",
  "stdio": {
    "command": "npx",
    "args": [
      "-y",
      "whatsapp-mcp-server"
    ],
    "env": [
      {
        "name": "WHATSAPP_ACCESS_TOKEN",
        "label": "Access token",
        "secret": true,
        "required": true
      },
      {
        "name": "WHATSAPP_PHONE_NUMBER_ID",
        "label": "Phone number id",
        "secret": true,
        "required": true
      }
    ]
  }
}
