{
  "schemaVersion": 1,
  "id": "prisma",
  "name": "Prisma Postgres",
  "description": "Query and manage a Prisma Postgres instance.",
  "category": "database",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "oauth",
  "remote": {
    "url": "https://mcp.prisma.io/mcp",
