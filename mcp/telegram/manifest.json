{
  "schemaVersion": 1,
  "id": "telegram",
  "name": "Telegram",
  "description": "Send messages and manage a Telegram bot.",
  "category": "comms",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "token",
  "stdio": {
    "command": "uvx",
    "args": [
      "telegram-mcp"
    ],
    "env": [
      {
        "name": "TELEGRAM_BOT_TOKEN",
        "label": "Bot token from BotFather",
        "secret": true,
        "required": true
      }
    ]
  }
}
