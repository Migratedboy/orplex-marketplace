{
  "schemaVersion": 1,
  "id": "youtube",
  "name": "YouTube",
  "description": "Search videos, fetch transcripts, and manage a channel.",
  "category": "data",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "token",
  "stdio": {
    "command": "uvx",
    "args": [
      "youtube-mcp"
    ],
    "env": [
      {
        "name": "YOUTUBE_API_KEY",
        "label": "YouTube Data API v3 key",
        "secret": true,
        "required": true
      }
    ]
  }
}
