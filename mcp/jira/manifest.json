{
  "schemaVersion": 1,
  "id": "jira",
  "name": "Jira",
  "description": "Search and update Jira issues, sprints, and boards.",
  "category": "devtools",
  "version": "1.0.0",
  "license": "MIT",
  "auth": "oauth",
  "popular": true,
  "remote": {
    "url": "https://mcp.atlassian.com/v1/mcp",
    "transport": "streamable-http"
  },
  "oauth": {
    "authority": "https://auth.atlassian.com",
    "scopes": [
      "read:jira-work",
      "read:jira-user",
      "write:jira-work",
      "offline_access"
    ]
  },
  "stdio": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-remote",
      "https://mcp.atlassian.com/v1/mcp"
    ],
    "env": []
  },
  "docsUrl": "https://www.atlassian.com/platform/remote-mcp-server"
}
